{
  "manifest_version": 3,
  "name": "trademarb",
  "version": "1.0.0",
  "description": "sort + filter your tradable inventory on roblox trade pages",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://trades.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://www.rolimons.com/*",
    "https://api.rolimons.com/*"
  ],
  "background": {
  "service_worker": "background.js",
  "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "content.css",
      "icons/rolimons.svg",
      "icons/projected.png",
      "icons/bagempty.webp",
      "icons/bagfull.webp",
      "icons/return.jpg",
      "icons/replacementimg.webp"
    ],
    "matches": ["https://www.roblox.com/*"]
  }],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/users/*/trade*",
        "https://www.roblox.com/trades/*/counter*",
        "https://www.roblox.com/trades*"
      ],
      "js": ["popuphandling.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/trade*",
        "https://www.roblox.com/trades/*/counter*",
        "https://www.roblox.com/trades*"
      ],
      "js": ["genericfunctions.js", "trade-composer.js", "trade-composer-values.js", "trades-list.js", "creatormode.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
